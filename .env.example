# marketplace-service — local dev env template.
# Copy to .env (gitignored) and fill in. NO real secrets in this file, ever.
# In a deployed cell these come from the cell's ConfigMap/Secret
# (ticketing-system deploy/k8s), NOT from a .env file.

# --- Database ---------------------------------------------------------------
DB_URL=jdbc:postgresql://localhost:5432/marketplace_service
DB_USERNAME=postgres
DB_PASSWORD=postgres

# --- Redis (shared fleet instance — logout denylist read side) --------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=dev-redis-password

# --- Service discovery ------------------------------------------------------
# Cell Eureka with basic-auth creds embedded, e.g.
# http://user:pass@discovery-server:8761/eureka/
EUREKA_SERVER_URL=http://localhost:8761/eureka/

# --- Cell identity ----------------------------------------------------------
INNBUCKS_COUNTRY=ZW
INNBUCKS_CURRENCY=USD

# --- Secrets (generate each with: openssl rand -base64 48) ------------------
# ProductionSecretsGuard refuses to boot under a deployment profile (any
# active-profile set with no dev/test/it/local — INCLUDING the empty set) on
# placeholders, blanks, or values under 32 chars. All values must be distinct.
JWT_SECRET=change-me-change-me-change-me-change-me
# Optional stage-1 RS256 dual-verify (PEM). Set fleet-wide before user-service
# flips minting to RS256.
JWT_PUBLIC_KEY=
INTERNAL_API_TOKEN=change-me-internal-token-change-me-internal-token
AUDIT_HMAC_SECRET=change-me-audit-hmac-secret-change-me-audit

# --- Monitoring -------------------------------------------------------------
# Blank fail-closes /actuator/prometheus. Same value fleet-wide.
METRICS_SCRAPE_TOKEN=

# --- Optional observability -------------------------------------------------
SENTRY_DSN=
TRACING_ENABLED=false
OTLP_ENDPOINT=http://localhost:4318/v1/traces
